# =============================================================================
# wikiuniverse .gitignore
#
# 方針(2026-09-25 合意のデータレイアウトに連動):
#   Git が追うもの   = コード(wu/ scripts/ tests/)・文書・notebooks・
#                      curated レポート(results/)・PROVENANCE.json
#   Git が追わないもの = data/ 以下の全生成物(dump/parsed/graph/community、
#                      将来の layout/spatial/final も含む)と環境・キャッシュ
#
# 大きな run 成果物(全グラフのコミュニティ割当など)は results/ ではなく
# data/community/ に置く運用(→ 自動的に Git 対象外)。results/ には
# 共有したいレポート(report.md / metrics.json / プロット)だけを置く。
# =============================================================================

# ---- 生成データ(工程別データディレクトリ、丸ごと対象外) ----------------------
/data/

# data/ 外に誤って置かれた大容量ファイル用のセーフティネット
*.sql.gz
*.bin
*.npy
*.npz
*.parquet.tmp
*.zip
*.tar
*.tar.gz
*.7z
*.sqlite
*.db

# ---- Python 仮想環境 ----------------------------------------------------------
.venv/
venv/
env/
ENV/
.env
.env.*

# ---- Python 生成物・キャッシュ -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
*.whl
.cache/

# ---- テスト・品質ツール ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# tests の合成データ生成物(実行時に再生成される)
/tests/synth_data/

# ---- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
# 実行済み出力で diff が肥大化したら nbstripout の導入を検討:
#   pip install nbstripout && nbstripout --install

# ---- OS / エディタ --------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---- ログ・一時ファイル ----------------------------------------------------------
*.log
tmp/
.tmp/
*.tmp

# ---- 個人用ローカルフォルダ(リポジトリ直下、追跡しない) -------------------------
/notes/
/archive/

# =============================================================================
# オプション(必要になったらコメント解除)
# =============================================================================
# results/ からノード単位の割当データだけ除外してリポジトリを軽くする場合:
# /results/*/communities.parquet
#
# results/ 全体を追跡しない場合(レポートは data/community/ 側で管理する運用):
# /results/